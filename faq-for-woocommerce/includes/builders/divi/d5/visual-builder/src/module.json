        "innerContent": {
          "desktop": {
            "value": "accordion"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "faqDisplay",
            "priority": 10,
            "render": true,
