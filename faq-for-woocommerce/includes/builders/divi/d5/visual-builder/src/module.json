      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "faqDisplay",
            "priority": 20,
            "render": true,
            "attrName": "layout.innerContent",
            "label": "Layout",
            "description": "Used when display mode is Accordion. 0 uses the layout from Happy FAQs settings.",
