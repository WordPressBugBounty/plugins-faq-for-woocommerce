            "component": {
              "name": "divi/select",
              "type": "field",
              "props": {
                "options": {
                  "0": { "label": "Default (Settings)" },
                  "1": { "label": "Classic" },
                  "2": { "label": "Whitish" },
                  "3": { "label": "Trip" },
                  "4": { "label": "Pop" },
                  "5": { "label": "Basic" }
                }
              }
            }
          }
        }
