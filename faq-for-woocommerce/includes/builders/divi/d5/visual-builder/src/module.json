    "showSearch": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "on"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "faqOptions",
            "priority": 10,
            "render": true,
            "attrName": "showSearch.innerContent",
            "label": "Show search box",
